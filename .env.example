# ServerKit Labs — environment config
# Copy this to .env and fill in your values

# The public IP of your VPS that users will SSH into
HOST_IP=YOUR_VPS_IP_HERE

# Port the Fastify API listens on
PORT=3000

# Address Fastify binds to (keep 0.0.0.0 for all interfaces)
BIND_HOST=0.0.0.0

# Secret for signing JWTs issued after Play Integrity verification (min 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret

# Key to access /dashboard and /api/admin/stats (leave unset to disable auth in dev)
ADMIN_KEY=change-me-to-admin-password

# Cloudflare R2 (S3-compatible) - holds persisted lab disk snapshots.
# See lib/snapshot-store.js. Required only for persisted labs; the free/
# ephemeral tier never touches R2.
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=your-r2-bucket-name
